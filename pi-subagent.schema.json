{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pi-subagent limits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "maxActive": { "type": "integer", "minimum": 1, "maximum": 256, "default": 16 },
    "maxParallelTasks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 50 },
    "maxChainSteps": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 12 },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 9007199254740991, "default": 16 },
    "maxChainParallelTasks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 8 },
    "maxBackgroundJobs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 16 },
    "backgroundHistoryLimit": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 20 },
    "backgroundHistoryTtlMs": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 3600000 },
    "backgroundOutputMaxBytes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "default": 16384 },
    "backgroundShutdownSettleMs": { "type": "integer", "minimum": 0, "maximum": 2147483647, "default": 3000 },
    "parallelHeartbeatMs": { "type": "integer", "minimum": 1, "maximum": 2147483647, "default": 1000 }
  }
}
